- institution ||= nil
- only_likely_countries ||= false
- default_country_code ||= nil
- required ||= false
- with_employer ||= false
- with_employer_address ||= false
- additional_field ||= false
- with_labels ||= false
- one_col ||= false
- whitelist_institute ||= false
- country_code_field ||= :country_code
- institution_code_field ||= :institution_code
- institution_name_field ||= :institution_name

- country_code = f.object.send(country_code_field)
- country_code ||= institution.country_code if institution.present?
- country_code ||= default_country_code

- institution_name_placeholder ||= t('placeholders.institution_name')
- label_class = required ? "required" : ""
- pending_field = institution_name_field.to_s.include?('second') ? :pending_second_institution_name : :pending_institution_name
- pending_name = f.object.respond_to?(pending_field) ? f.object.read_attribute(pending_field) : nil
- employer_name_field ||= :employer
- employer_name_placeholder ||= t('placeholders.employer')
- employer_address_placeholder ||= t('placeholders.employer_address')
- additional_field_placeholder ||= t("placeholders.#{additional_field}") if additional_field

- rowclass = additional_field ? "threecol" : "twocol unequal"

- institution_code_value = f.object.send(institution_code_field)
- institution_selection = Institution.for_selection(country_code, false, whitelist_institute)
- if pending_name.present? && institution_code_value.blank?
  - institution_selection = [["#{pending_name} (unverified)", "pending:#{pending_name}"]] + institution_selection

- if only_likely_countries
  - country_options = Country.likely_for_selection
- else
  - country_options = Country.for_selection
- unless one_col
  %fieldset.institution_chooser{data: {role: "institution", required: required}}
    - if whitelist_institute
      = f.hidden_field 'whitelisted', value: true, class: 'whitelist_institute'
    %p{class: rowclass}
      %span.col.first>
        - if with_labels
          = f.label country_code_field
        = f.select country_code_field, country_options, {include_blank: t("placeholders.please_choose_country"), selected: country_code, disabled: "-"}, data: {key: country_code_field, role: 'country'}
        
      - select_cell_class = additional_field ? "col" : "col last"
      %span{class: select_cell_class}>
        - if with_labels
          = f.label institution_code_field
        %span{data: {role: "choose"}}
          - select_opts = pending_name.present? && institution_code_value.blank? ? {selected: "pending:#{pending_name}"} : {include_blank: t("placeholders.please_choose_institution")}
          = f.select institution_code_field, institution_selection, select_opts, {data: {key: institution_code_field, select: 'select2'}}
        %span{data: {role: "add"}}
          = f.text_field institution_name_field, placeholder: institution_name_placeholder, suggestible: true, class: 'institution_suggest_selection', value: pending_name.to_s
        - if with_employer
          %span{data: {role: "other"}}
            = f.text_field employer_name_field, placeholder: employer_name_placeholder, data: {key: employer_name_field}
        %br
        = link_to t(:choose_institution), '#', class: 'note', data: {role: "showchoose"}
        -# = link_to t(:add_institution), '#', class: 'note', data: {role: "showadd"}
        - if with_employer
          %span.or
            = t :or
          = link_to t(:other_employer), '#', class: 'note', data: {role: "showother"}

      - if additional_field
        %span.col.last>
          - if with_labels
            - if additional_field == :post
              = f.label additional_field, "Position"
            - else
              = f.label additional_field
          = f.text_field additional_field, placeholder: additional_field == :post ? "Position" : additional_field_placeholder

    - if with_employer && with_employer_address
      %p.address{data: {role: "other"}}
        = f.text_area :employer_address, placeholder: employer_address_placeholder
- else
  %fieldset.institution_chooser{data: {role: "institution", required: required}}
    - if whitelist_institute
      = f.hidden_field 'whitelisted', value: true, class: 'whitelist_institute'
    %p.onecol.appl_form_onecol
      %span.col.first>
        - if with_labels
          = f.label country_code_field, 'Country'
        = f.select country_code_field, country_options, {include_blank: t("placeholders.please_choose_country"), selected: country_code, disabled: "-"}, data: {key: country_code_field, role: 'country'}
    %p.onecol.appl_form_onecol    
      - select_cell_class = additional_field ? "col" : "col last"
      %span{class: select_cell_class}>
        - if with_labels
          = f.label institution_code_field, 'University'
        %span{data: {role: "choose"}}
          - select_opts = pending_name.present? && institution_code_value.blank? ? {selected: "pending:#{pending_name}"} : {include_blank: t("placeholders.please_choose_institution")}
          = f.select institution_code_field, institution_selection, select_opts, {data: {key: institution_code_field, select: 'select2'}}
        %span{data: {role: "add"}}
          = f.text_field institution_name_field, placeholder: institution_name_placeholder, suggestible: true, class: 'institution_suggest_selection', value: pending_name.to_s
        - if with_employer
          %span{data: {role: "other"}}
            = f.text_field employer_name_field, placeholder: employer_name_placeholder, data: {key: employer_name_field}
        %br
        = link_to t(:choose_institution), '#', class: 'note', data: {role: "showchoose"}
        -# = link_to t(:add_institution), '#', class: 'note', data: {role: "showadd"}
        - if with_employer
          %span.or
            = t :or
          = link_to t(:other_employer), '#', class: 'note', data: {role: "showother"}

      - if additional_field
        %p.onecol.appl_form_onecol
          %span.col.last>
            - if with_labels
              - if additional_field == :post
                = f.label additional_field, "Position"
              - else
                = f.label additional_field
            = f.text_field additional_field, placeholder: additional_field == :post ? "Position" : additional_field_placeholder

    - if with_employer && with_employer_address
      %p.address{data: {role: "other"}}
        = f.text_area :employer_address, placeholder: employer_address_placeholder
